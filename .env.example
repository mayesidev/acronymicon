DATABASE_PATH=./data/acronymicon.sqlite
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=false

# Standard is suitable for local development. See README.md before enabling controlled.
ACRONYMICON_DEPLOYMENT_PROFILE=standard
ACRONYMICON_DICTIONARY_ACCESS=open
ACRONYMICON_PUBLIC_ORIGIN=http://localhost:5173

# Generic OIDC configuration. Keycloak can be used for local development.
OIDC_ISSUER_URL=http://localhost:8080/realms/acronymicon
OIDC_CLIENT_ID=acronymicon
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email

# Optional claim mapping overrides.
OIDC_CLAIM_USER_ID=sub
OIDC_CLAIM_USERNAME=preferred_username
OIDC_CLAIM_DISPLAY_NAME=name
OIDC_CLAIM_EMAIL=email
OIDC_CLAIM_GROUPS=groups
