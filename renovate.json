{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "prHourlyLimit": 0,
  "semanticCommits": "enabled",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Keep dependency updates non-releasing by default",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Release updates to shipped application dependencies",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-runtime"
    },
    {
      "description": "Do not release GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Release updates to the shipped container",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "runtime"
    }
  ]
}
