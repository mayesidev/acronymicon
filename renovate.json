{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "prHourlyLimit": 0,
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^pnpm-workspace\\.yaml$/"],
      "matchStrings": ["nodeVersion:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/publish-container\\.yml$/"],
      "matchStrings": [
        "runner:[ \\t]*ubuntu-(?<currentValue>\\d+\\.\\d+)[ \\t]*\\r?\\n"
      ],
      "depNameTemplate": "ubuntu",
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker"
    }
  ],
  "semanticCommits": "enabled",
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "description": "Keep compatible ESLint peer tooling updates together",
      "matchPackageNames": [
        "@eslint/js",
        "eslint",
        "eslint-plugin-react-hooks",
        "typescript-eslint"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "ESLint toolchain"
    },
    {
      "description": "Keep dependency updates non-releasing by default",
      "matchPackageNames": [
        "*"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Release updates to shipped application dependencies",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "dependencies",
        "optionalDependencies"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-runtime"
    },
    {
      "description": "Do not release GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Release updates to the shipped container",
      "matchManagers": [
        "dockerfile"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "runtime"
    },
    {
      "description": "Update the Node image, pnpm runtime version, and Node types together",
      "matchPackageNames": ["node", "@types/node"],
      "matchFileNames": ["Dockerfile", "pnpm-workspace.yaml", "package.json"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Node.js toolchain",
      "semanticCommitType": "build",
      "semanticCommitScope": "runtime"
    },
    {
      "description": "Release lockfile refreshes because transitive runtime packages can change",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps-runtime"
    },
    {
      "description": "Move x64 and ARM Ubuntu runners together",
      "matchDatasources": ["github-runners"],
      "matchPackageNames": ["ubuntu"],
      "groupName": "Ubuntu runners",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    }
  ]
}
