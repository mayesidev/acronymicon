{
  "realm": "acronymicon",
  "enabled": true,
  "displayName": "Acronymicon",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "clients": [
    {
      "clientId": "acronymicon",
      "name": "Acronymicon",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-development-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://localhost:3100/auth/callback",
        "http://localhost:3101/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:3100",
        "http://localhost:3101"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:5173/##http://localhost:3100/##http://localhost:3101/"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "acronymicon-controlled-e2e",
      "name": "Acronymicon controlled browser fixture",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-controlled-e2e-client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["https://localhost:3102/auth/callback"],
      "webOrigins": ["https://localhost:3102"],
      "attributes": {
        "post.logout.redirect.uris": "https://localhost:3102/"
      },
      "defaultClientScopes": ["web-origins", "acr", "profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"],
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "groups": [
    {
      "name": "acronymicon-admin"
    },
    {
      "name": "acronymicon-moderator"
    }
  ],
  "users": [
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "User",
      "email": "user@example.test",
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Admin",
      "email": "admin@example.test",
      "groups": ["/acronymicon-admin"],
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ]
    }
  ]
}
