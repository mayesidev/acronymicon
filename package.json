{
  "name": "acronymicon",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.18.0 <12"
  },
  "scripts": {
    "build": "react-router build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/ensure-database-directory.ts && drizzle-kit migrate",
    "db:seed": "tsx scripts/import-acronyms.ts seeds/acronyms.seed.json",
    "db:seed:container": "node scripts/import-acronyms.mjs seeds/acronyms.seed.json",
    "dev": "react-router dev",
    "import:acronyms": "tsx scripts/import-acronyms.ts",
    "import:acronyms:container": "node scripts/import-acronyms.mjs",
    "start": "react-router-serve ./build/server/index.js",
    "security:audit": "pnpm audit --audit-level low",
    "security:audit:signatures": "pnpm audit signatures",
    "security:check": "pnpm run security:audit && pnpm run security:audit:signatures",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "better-sqlite3": "^13.0.2",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c"
}
