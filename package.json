{
  "name": "acronymicon",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "build": "react-router build && vite build --config vite.importer.config.ts && vite build --config vite.session-revocation.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:seed": "tsx scripts/import-acronyms.ts seeds/acronyms.seed.json",
    "db:seed:container": "node build/scripts/import-acronyms.mjs seeds/acronyms.seed.json",
    "dev": "react-router dev",
    "import:acronyms": "tsx scripts/import-acronyms.ts",
    "import:acronyms:container": "node build/scripts/import-acronyms.mjs",
    "sessions:revoke": "tsx scripts/revoke-user-sessions.ts",
    "sessions:revoke:container": "node build/scripts/revoke-user-sessions.mjs",
    "lint": "eslint .",
    "lint:commit": "commitlint",
    "start": "react-router-serve ./build/server/index.js",
    "security:audit": "pnpm audit --audit-level low",
    "security:audit:signatures": "pnpm audit signatures",
    "security:check": "pnpm run security:audit && pnpm run security:audit:signatures",
    "security:container-policy": "node scripts/check-container-scan.mjs",
    "test": "vitest run",
    "test:container": "node scripts/smoke-container.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "^8.3.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "5.0.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.11.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "semantic-release": "25.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.2.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c"
}
