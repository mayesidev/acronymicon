{
  "name": "acronymicon",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "build": "react-router build && vite build --config vite.importer.config.ts && vite build --config vite.session-revocation.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate-database.ts",
    "db:seed": "tsx scripts/import-acronyms.ts seeds/acronyms.seed.json",
    "db:seed:container": "node build/scripts/import-acronyms.mjs seeds/acronyms.seed.json",
    "dev": "react-router dev",
    "import:acronyms": "tsx scripts/import-acronyms.ts",
    "import:acronyms:container": "node build/scripts/import-acronyms.mjs",
    "sessions:revoke": "tsx scripts/revoke-user-sessions.ts",
    "sessions:revoke:container": "node build/scripts/revoke-user-sessions.mjs",
    "lint": "eslint .",
    "lint:commit": "commitlint",
    "start": "react-router-serve ./build/server/index.js",
    "security:audit": "pnpm audit --audit-level low",
    "security:audit:signatures": "pnpm audit signatures",
    "security:check": "pnpm run security:audit && pnpm run security:audit:signatures",
    "test": "vitest run",
    "test:container": "node scripts/smoke-container.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:server": "node scripts/e2e-server.mjs",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage && pnpm run build"
  },
  "dependencies": {
    "@react-router/node": "^8.3.0",
    "@react-router/serve": "^8.3.0",
    "better-sqlite3": "^13.0.2",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.2.1",
    "openid-client": "^6.8.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "^8.3.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "5.1.2",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "10.15.0",
    "eslint-plugin-jest-dom": "5.11.0",
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.3",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "semantic-release": "26.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "^8.2.1",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@11.29.0+sha512.d913f9b37cd5fe6780052e809774edabb7bdcf69a6e6d9b8fd3b38bc052fa8a7d891b6c201a38fb504a07ffce2e5e8c262ef54fb8f57db62f22d353a30bc8a96"
}
